<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:id="@+id/root"
              android:orientation="vertical"
              android:background="#FFFFFF"
              android:layout_width="match_parent"
              android:layout_height="match_parent">
  <LinearLayout android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
    <ImageView android:src="@drawable/app_logo"
               android:importantForAccessibility="no"
               android:layout_marginEnd="12dp"
               android:layout_width="36dp"
               android:layout_height="36dp" />
    <TextView android:text="@string/app_name"
              android:textSize="22sp"
              android:textStyle="bold"
              android:textColor="#202327"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
  </LinearLayout>
  <TextView android:id="@+id/file_name"
            android:text="@string/no_file"
            android:textSize="14sp"
            android:textColor="#5B626C"
            android:maxLines="2"
            android:ellipsize="end"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
  <LinearLayout android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
    <Button android:id="@+id/open_file"
            android:text="@string/open_file"
            android:textAllCaps="false"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content" />
    <ImageButton android:id="@+id/reload_file"
                 android:src="@android:drawable/ic_popup_sync"
                 android:tint="#16775E"
                 android:background="?android:attr/selectableItemBackgroundBorderless"
                 android:contentDescription="@string/reload_file"
                 android:tooltipText="@string/reload_file"
                 android:enabled="false"
                 android:layout_width="48dp"
                 android:layout_height="48dp" />
  </LinearLayout>
  <RadioGroup android:id="@+id/view_tabs"
              android:orientation="horizontal"
              android:checkedButton="@+id/preview_tab"
              android:paddingStart="16dp"
              android:paddingEnd="16dp"
              android:paddingBottom="8dp"
              android:layout_width="match_parent"
              android:layout_height="wrap_content">
    <RadioButton android:id="@id/preview_tab"
                 android:text="@string/preview"
                 android:textSize="14sp"
                 android:textColor="#202327"
                 android:gravity="center"
                 android:button="@null"
                 android:background="@drawable/tab_selector"
                 android:layout_marginEnd="4dp"
                 android:minHeight="48dp"
                 android:layout_weight="1"
                 android:layout_width="0dp"
                 android:layout_height="wrap_content" />
    <RadioButton android:id="@+id/raw_tab"
                 android:text="@string/raw_text"
                 android:textSize="14sp"
                 android:textColor="#202327"
                 android:gravity="center"
                 android:button="@null"
                 android:background="@drawable/tab_selector"
                 android:minHeight="48dp"
                 android:layout_weight="1"
                 android:layout_width="0dp"
                 android:layout_height="wrap_content" />
  </RadioGroup>
  <ProgressBar android:id="@+id/loading"
               style="?android:attr/progressBarStyleHorizontal"
               android:indeterminate="true"
               android:visibility="gone"
               android:layout_width="match_parent"
               android:layout_height="3dp" />
  <FrameLayout android:layout_weight="1"
               android:layout_width="match_parent"
               android:layout_height="0dp">
    <WebView android:id="@+id/preview_browser"
             android:visibility="gone"
             android:layout_width="match_parent"
             android:layout_height="match_parent" />
    <ScrollView android:id="@+id/raw_scroll"
                android:visibility="gone"
                android:fillViewport="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
      <TextView android:id="@+id/raw_content"
                android:fontFamily="monospace"
                android:textSize="15sp"
                android:textColor="#202327"
                android:textIsSelectable="true"
                android:padding="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
    </ScrollView>
    <TextView android:id="@+id/empty_state"
              android:text="@string/no_file"
              android:textSize="16sp"
              android:textColor="#5B626C"
              android:gravity="center"
              android:padding="24dp"
              android:layout_width="match_parent"
              android:layout_height="match_parent" />
  </FrameLayout>
  <TextView android:id="@+id/status"
            android:text="@string/ready"
            android:textColor="#365349"
            android:background="#EFF6F2"
            android:textSize="13sp"
            android:accessibilityLiveRegion="polite"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
</LinearLayout>
